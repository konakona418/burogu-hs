cabal-version:   3.0
name:            burogu
version:         0.1.0.0
license:         AGPL-3.0-or-later
license-file:    LICENSE
maintainer:      creeperblin@outlook.com
author:          moe li
homepage:        lizi.moe
category:        Web
build-type:      Simple

executable burogu
    main-is:          Main.hs
    other-modules:    Build
                    , Cli
                    , Config
                    , Css
                    , Deploy
                    , Feed
                    , Html
                    , Init
                    , NewPost
                    , Page
                    , Pandoc
                    , Paths_burogu
                    , Post
                    , Registry
                    , Search
                    , Shaft
                    , Sitemap
                    , Site
                    , Sync
                    , Watch
    hs-source-dirs:   app
    default-language: GHC2021
    default-extensions: OverloadedStrings
    ghc-options:      -Wall
    build-depends:    base ^>=4.18.3.0
                    , aeson >=2.3.1.0 && <2.4
                    , bytestring >=0.11.5.3 && <0.12
                    , clay >=0.16.1 && <0.17
                    , containers >=0.6.7 && <0.7
                    , directory >=1.3.8.5 && <1.4
                    , filepath >=1.4.300.1 && <1.5
                    , lucid >=2.11.20260427 && <2.12
                    , network >=3.2.8.0 && <3.3
                    , optparse-applicative >=0.19.0.0 && <0.20
                    , pandoc >=3.10.1 && <3.11
                    , pandoc-types >=1.23.1.2 && <1.24
                    , process >=1.6.19.0 && <1.7
                    , scientific >=0.3.7.0 && <0.4
                    , text >=2.0.2 && <2.1
                    , time >=1.12.2 && <1.13
                    , yaml >=0.11.11.2 && <0.12

test-suite burogu-test
    type:             exitcode-stdio-1.0
    main-is:          PostSpec.hs
    other-modules:    Build
                    , Cli
                    , Config
                    , Css
                    , Deploy
                    , Feed
                    , Html
                    , Init
                    , NewPost
                    , Page
                    , Pandoc
                    , Paths_burogu
                    , Post
                    , Registry
                    , Search
                    , Shaft
                    , Sitemap
                    , Site
                    , Sync
                    , Watch
    hs-source-dirs:   test
                    , app
    default-language: GHC2021
    default-extensions: OverloadedStrings
    ghc-options:      -Wall
    build-depends:    base ^>=4.18.3.0
                    , aeson >=2.3.1.0 && <2.4
                    , bytestring >=0.11.5.3 && <0.12
                    , clay >=0.16.1 && <0.17
                    , containers >=0.6.7 && <0.7
                    , directory >=1.3.8.5 && <1.4
                    , filepath >=1.4.300.1 && <1.5
                    , lucid >=2.11.20260427 && <2.12
                    , network >=3.2.8.0 && <3.3
                    , optparse-applicative >=0.19.0.0 && <0.20
                    , pandoc >=3.10.1 && <3.11
                    , pandoc-types >=1.23.1.2 && <1.24
                    , process >=1.6.19.0 && <1.7
                    , scientific >=0.3.7.0 && <0.4
                    , tasty >=1.5.4 && <1.6
                    , tasty-hunit >=0.10.2 && <0.11
                    , text >=2.0.2 && <2.1
                    , time >=1.12.2 && <1.13
                    , yaml >=0.11.11.2 && <0.12
