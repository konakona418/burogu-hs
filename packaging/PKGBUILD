# Maintainer: moe li <creeperblin@outlook.com>
#
# Build a source tarball first (from the repo root):
#   git archive --format=tar.gz --prefix=burogu-0.1.0.0/ -o packaging/burogu-0.1.0.0.tar.gz HEAD
# (or, before committing: tar --exclude=.git --exclude=dist-newstyle --exclude=site \
#     -czf packaging/burogu-0.1.0.0.tar.gz --transform 's,^,burogu-0.1.0.0/,' app test burogu.cabal config.yaml)
# Then, inside packaging/: makepkg -i
#
# GHC from ghcup: ghc and cabal-install are not pacman packages, so
# dependency checks must be skipped (they live on PATH instead):
#   makepkg -d -i
#
# The build compiles all Haskell dependencies from Hackage inside the
# sandbox (network required). Runtime dependencies: gmp and zlib (linked
# by the binary), rsync (deploy), git (sync). No cabal or python3 are
# needed at runtime: preview/watch build in-process and serve with a
# built-in HTTP server.

pkgname=burogu
pkgver=0.1.0.0
pkgrel=1
pkgdesc="A static blog generator written in Haskell"
arch=('x86_64')
url="https://lizi.moe"
license=('AGPL-3.0-or-later')
depends=('gmp' 'zlib' 'rsync' 'git')
makedepends=('ghc' 'cabal-install')
# sha256sums is SKIP for the local tarball; fill it in when publishing
# to the AUR.
source=("burogu-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/burogu-$pkgver"
    cabal update
    cabal build exe:burogu
}

package() {
    cd "$srcdir/burogu-$pkgver"
    install -Dm755 "$(cabal list-bin exe:burogu)" "$pkgdir/usr/bin/burogu"
}
